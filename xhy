#!/usr/bin/env bash
# 开发入口：直接在仓库里运行（逻辑分散在 lib/ 与 entry/main.sh）。
#
# 发布给用户的是 `./build.sh` 生成的单文件 install.sh —— 两者共用同一套
# lib/ 与 entry/main.sh，所以这里不需要重复任何实现。
#
# 用户侧请用：
#   bash <(curl -fsSL https://github.com/jmwangde3/xray-hy/releases/latest/download/install.sh)
set -Eeuo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export XHY_DEV=1
export XHY_APP_DIR="${XHY_APP_DIR:-$REPO}"
export XHY_SCRIPT_DIR="$REPO"
export XHY_SELF="$REPO/xhy"

if [[ "${XHY_TRACE:-0}" == "1" ]]; then
    PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
    set -x
fi

for _lib in common platform core service hardening target nodes links update; do
    # shellcheck disable=SC1090
    source "$REPO/lib/${_lib}.sh" || { echo "cannot load lib/${_lib}.sh" >&2; exit 1; }
done

# shellcheck disable=SC1091
source "$REPO/entry/main.sh"
