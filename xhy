#!/usr/bin/env bash
# 开发入口：直接在仓库里运行（逻辑分散在 lib/ 与 entry/main.sh）。
#
# 发布给用户的是 `./build.sh` 生成的单文件 install.sh —— 两者共用同一套
# lib/ 与 entry/main.sh，所以这里不需要重复任何实现。
#
# 用户侧请用：
#   bash <(curl -fsSL https://github.com/jmwangde3/xray-hy/releases/latest/download/install.sh)
set -Eeuo pipefail

# 仓库根必须从「真实文件」推导：install 会做 /usr/local/bin/xhy -> $REPO/xhy
# 软链，经过软链调用时 BASH_SOURCE 是链接本身，不解析会把 /usr/local/bin
# 当成仓库根，然后 source /usr/local/bin/lib/common.sh 直接失败。
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"
    _src="$(readlink "$_src")"
    [[ $_src == /* ]] || _src="$_dir/$_src"
done
REPO="$(cd -P "$(dirname "$_src")" && pwd)"
export XHY_DEV=1
export XHY_APP_DIR="${XHY_APP_DIR:-$REPO}"
export XHY_SCRIPT_DIR="$REPO"
export XHY_SELF="$REPO/xhy"
# 这两个变量在单文件里由 entry/prelude.sh 定义；开发入口不加载 prelude，
# 必须自己补上，否则 install_self 在 set -u 下直接死在 XHY_RUNNING 上。
# 开发模式下「正在运行的就是 $REPO/xhy」，与 XHY_SELF 同路径 => install_self 什么都不做。
export XHY_RUNNING="${XHY_RUNNING:-$REPO/xhy}"
export XHY_INSTALL_URL="${XHY_INSTALL_URL:-https://github.com/jmwangde3/xray-hy/releases/latest/download/install.sh}"

if [[ "${XHY_TRACE:-0}" == "1" ]]; then
    PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
    set -x
fi

for _lib in common i18n sockopt platform core service hardening target scanner nodes links export backup update; do
    # shellcheck disable=SC1090
    source "$REPO/lib/${_lib}.sh" || { echo "cannot load lib/${_lib}.sh" >&2; exit 1; }
done

# shellcheck disable=SC1091
source "$REPO/entry/main.sh"
